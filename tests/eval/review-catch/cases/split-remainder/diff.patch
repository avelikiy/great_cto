new file mode 100644
--- /dev/null
+++ b/src/ledger/split.ts
@@ -0,0 +1,14 @@
+export interface Share {
+  participantId: string;
+  amountCents: number;
+}
+
+/**
+ * Split a bill between participants in integer cents.
+ */
+export function splitBill(totalCents: number, participantIds: string[]): Share[] {
+  if (!Number.isInteger(totalCents) || totalCents < 0) throw new RangeError('totalCents');
+  if (participantIds.length === 0) throw new RangeError('no participants');
+  const each = Math.floor(totalCents / participantIds.length);
+  return participantIds.map((participantId) => ({ participantId, amountCents: each }));
+}
