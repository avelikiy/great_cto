+import { test, expect } from 'vitest';
+import { splitBill } from './split';
+
+test('splits evenly', () => {
+  const shares = splitBill(900, ['a', 'b', 'c']);
+  expect(shares.map((s) => s.amountCents)).toEqual([300, 300, 300]);
+});
