diff --git a/src/export/pdf.ts b/src/export/pdf.ts
new file mode 100644
--- /dev/null
+++ b/src/export/pdf.ts
@@ -0,0 +1,13 @@
+import { exec } from 'node:child_process';
+import { promisify } from 'node:util';
+import { renderStatementHtml } from './html';
+import type { Request, Response } from 'express';
+
+const run = promisify(exec);
+
+export async function exportPdf(req: Request, res: Response) {
+  const name = String(req.query.name || 'statement');
+  const htmlPath = await renderStatementHtml(req.user.accountId, name);
+  await run(`wkhtmltopdf ${htmlPath} /tmp/${name}.pdf`);
+  res.download(`/tmp/${name}.pdf`);
+}
