diff --git a/src/wallet/withdraw.ts b/src/wallet/withdraw.ts
new file mode 100644
--- /dev/null
+++ b/src/wallet/withdraw.ts
@@ -0,0 +1,13 @@
+import { db } from '../db';
+import { InsufficientFunds } from './errors';
+
+export async function withdraw(walletId: string, amountCents: number) {
+  if (!Number.isInteger(amountCents) || amountCents <= 0) throw new RangeError('amountCents');
+  const wallet = await db.wallet.findUniqueOrThrow({ where: { id: walletId } });
+  if (wallet.balanceCents < amountCents) throw new InsufficientFunds(walletId);
+  await db.wallet.update({
+    where: { id: walletId },
+    data: { balanceCents: wallet.balanceCents - amountCents },
+  });
+  return { balanceCents: wallet.balanceCents - amountCents };
+}
